// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CardStatus {
  ACTIVE
  INACTIVE
  PENDING
  EXPIRED
}

// ==================== MODELS ====================

model User {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  email         String  @unique
  password      String?
  name          String?
  phone         String?
  avatar        String?
  role          Role    @default(CUSTOMER)
  emailVerified Boolean @default(false)
  isActive      Boolean @default(true)

  // Relations
  orders Order[]
  cards  Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  price       Float
  salePrice   Float?
  images      String[]
  category    String?
  tags        String[]
  sku         String?  @unique
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // NFC Card specific fields
  cardType String? // e.g., "standard", "premium", "metal"
  material String?
  color    String?

  // Relations
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Order {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String @unique

  // Customer info
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  // Guest checkout info
  guestEmail String?
  guestName  String?
  guestPhone String?

  // Purchase form details
  designation String?
  company     String?
  website     String?
  address     String?
  cardType    String?
  price       Float?
  templateSlug String?
  profileData Json?

  // Order details
  items    OrderItem[]
  subtotal Float
  discount Float       @default(0)
  shipping Float       @default(0)
  tax      Float       @default(0)
  total    Float

  // Status
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentId     String? // External payment reference

  // Shipping address
  shippingAddress Address?

  // Billing address
  billingAddress Address?

  // Associated Card (created when order is confirmed)
  cardId String? @db.ObjectId

  // NFC link email tracking
  nfcLinkEmailSent Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dashboard access paths: recent-orders sort, status/payment aggregation,
  // month-scoped revenue, and the recent-orders join on userId.
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([paymentStatus])
  @@index([userId])
  @@index([status, createdAt(sort: Desc)])
  @@index([paymentStatus, createdAt(sort: Desc)])
  @@map("orders")
}

type Address {
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  phone        String?
}

type OrderItem {
  productId   String @db.ObjectId
  productName String
  quantity    Int
  price       Float
  total       Float
}

model Card {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  slug String @unique

  // Owner
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  // Card info
  cardType String?
  nfcId    String?    @unique // Physical NFC chip ID
  status   CardStatus @default(PENDING)

  // Card details (embedded)
  details CardDetail?

  // Analytics
  views      Int       @default(0)
  taps       Int       @default(0)
  lastTapped DateTime?

  // Leads captured
  leads CardLead[]

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cards")
}

type CardDetail {
  // Personal info
  firstName String?
  lastName  String?
  title     String?
  company   String?
  bio       String?

  // Contact info
  email   String?
  phone   String?
  website String?

  // Profile image
  profileImage String?
  coverImage   String?
  logo         String?

  // Social links
  socialLinks SocialLinks?

  // Custom fields
  customFields CustomField[]

  // Theme/styling
  theme           String?
  primaryColor    String?
  backgroundColor String?
}

type SocialLinks {
  linkedin  String?
  twitter   String?
  facebook  String?
  instagram String?
  youtube   String?
  tiktok    String?
  github    String?
  whatsapp  String?
  telegram  String?
  snapchat  String?
}

type CustomField {
  label String
  value String
  type  String // text, link, email, phone
  icon  String?
}

model CardLead {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Associated card
  cardId String @db.ObjectId
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Lead info
  name    String?
  email   String?
  phone   String?
  company String?
  message String?

  // Metadata
  source    String? // qr, nfc, link
  ipAddress String?
  userAgent String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("card_leads")
}

model Customer {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  designation  String?
  company      String?
  about        String?
  phone        String
  email        String
  mailApiEndpoint String?
  website      String?
  websiteEnabled   Boolean @default(false)
  linkedin         String?
  linkedinEnabled  Boolean @default(false)
  whatsapp         String?
  whatsappEnabled  Boolean @default(false)
  instagram        String?
  instagramEnabled Boolean @default(false)
  facebook         String?
  facebookEnabled  Boolean @default(false)
  behance          String?
  behanceEnabled   Boolean @default(false)
  address      String?
  mapEmbedUrl  String?
  logo         String?
  profileImage String?
  isActive     Boolean  @default(true)
  slug         String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  galleries Gallery[]
  leads     Lead[]

  // Dashboard active/disabled split.
  @@index([isActive])
  @@map("customers")
}

// ==================== PAYMENT ADAPTER LAYER ====================

model PaymentLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Link to existing order
  existingOrderId String @db.ObjectId
  
  // Razorpay payment details
  razorpayOrderId   String @unique
  razorpayQrCodeId  String?
  razorpayPaymentId String?
  razorpaySignature String?

  // Payment info
  amount   Float
  currency String @default("INR")
  status   String @default("PENDING") // PENDING, SUCCESS, FAILED

  // Optional user details
  userEmail  String?
  userPhone  String?
  userName   String?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([existingOrderId])
  @@index([status])
  @@map("payments_log")
}

model Gallery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  image      String
  hoverText  String?
  slot       Int

  @@unique([customerId, slot])
  @@map("galleries")
}

model Lead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String?
  message    String
  createdAt  DateTime @default(now())

  @@map("leads")
}

model MainWebsiteLead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  source    String   @default("main-website")
  name      String
  phone     String
  email     String?
  subject   String?
  message   String?
  service   String?
  createdAt DateTime @default(now())

  // Dashboard leads-this-month window.
  @@index([createdAt(sort: Desc)])
  @@map("main_website_leads")
}

model NewsletterSubscriber {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  name     String?
  isActive Boolean @default(true)
  source   String? // website, checkout, popup

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model Newsletter {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  subject     String
  slug        String  @unique
  content     String // HTML content
  previewText String?

  // Stats
  sentCount  Int @default(0)
  openCount  Int @default(0)
  clickCount Int @default(0)

  isSent      Boolean   @default(false)
  sentAt      DateTime?
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletters")
}

// ==================== BLOG ====================

enum PostStatus {
  DRAFT
  PUBLISHED
}

/// A Cloudinary-backed image. `publicId` is stored so deleting the post (or
/// replacing the image) can also delete the asset from Cloudinary — an URL
/// alone is not enough to do that reliably. `alt` is required, not optional:
/// an image with no alt text must never reach a published page.
type PostImage {
  url      String
  publicId String
  alt      String
  width    Int
  height   Int
}

model Post {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  title   String
  slug    String @unique
  excerpt String
  content String // sanitized HTML — see src/lib/blog/sanitize.ts

  coverImage    PostImage?
  galleryImages PostImage[]

  tags     String[]
  category String?

  authorName   String
  authorAvatar String?

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  // Computed server-side from `content` on every write, never sent by the
  // client, so it cannot drift from the body it describes.
  readingTimeMinutes Int @default(1)

  // SEO overrides. Each falls back to its content field when null.
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonicalUrl    String?
  noindex         Boolean @default(false)

  views       Int @default(0)
  uniqueViews Int @default(0)

  postViews PostView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Public listing and tag archives read published posts newest-first.
  @@index([status, publishedAt(sort: Desc)])
  @@index([tags])
  // Admin "top posts by views" sort.
  @@index([views(sort: Desc)])
  @@map("posts")
}

model PostView {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  postId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Both are SHA-256 digests peppered with JWT_SECRET — no raw IP is stored.
  sessionHash String
  ipHash      String

  userAgent String?
  referrer  String?
  country   String?

  createdAt DateTime @default(now())

  // One row per view, so the daily chart sees repeat visits and not just first
  // ones. This index is what makes the "has this session read this post
  // before?" lookup — which decides uniqueViews, and absorbs a strict-mode
  // double fire — a single indexed read rather than a scan.
  @@index([postId, sessionHash, createdAt(sort: Desc)])
  // 30-day views chart, per post and site-wide.
  @@index([postId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("post_views")
}

/// Changing a published post's slug must never strand the old URL. Every
/// previous slug is kept here and served as a 301 to the current one.
model PostSlugRedirect {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  oldSlug String @unique
  postId  String @db.ObjectId

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("post_slug_redirects")
}
