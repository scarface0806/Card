# ---------------------------------------------------------------------------
# Copy to .env.local and fill in real values. NEVER commit a filled-in copy.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=

# App
# Public origin used for canonical URLs, the sitemap, OG images and JSON-LD.
# MUST be set on the production deployment, or canonicals fall back to
# NEXT_PUBLIC_APP_URL (localhost in development).
# e.g. https://tapvyo-nfc-card.vercel.app
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_APP_URL=
JWT_SECRET=

# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
# Public key id (rzp_test_... / rzp_live_...). Safe to expose to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Same key id, read server-side. Keep both set to the same value.
RAZORPAY_KEY_ID=


# SECRET. Server-only. Must never appear in client code or a NEXT_PUBLIC_ var.
RAZORPAY_KEY_SECRET=

# Webhook signing secret from Razorpay Dashboard -> Settings -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# "test" or "live"
RAZORPAY_MODE=test

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
# Backs every admin image upload, including blog cover and inline images
# (folder: admin/blog). SERVER-ONLY - none of these may become a NEXT_PUBLIC_
# variable. Set either CLOUDINARY_URL on its own, or all three below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternative single-value form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ---------------------------------------------------------------------------
# Blog
# ---------------------------------------------------------------------------
# Show the view counter on public post pages. Admin always sees view counts in
# /admin/blogs regardless of this. Default (unset or anything but "true"): off.
NEXT_PUBLIC_BLOG_SHOW_VIEWS=
