# ---------------------------------------------------------------------------
# Copy to .env.local and fill in real values. NEVER commit a filled-in copy.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=

# App
# Public origin used for canonical URLs, the sitemap, OG images and JSON-LD.
#
# THE PRIMARY DOMAIN IS https://tapvyo.in (apex, no www).
#
# MUST be set explicitly on the production deployment. If it is empty, the
# resolver in src/lib/site-config.ts falls through to Vercel's own env vars and
# resolves to the *.vercel.app alias - which would stamp the old host into
# every canonical, OG URL and sitemap entry and undo the domain migration.
# Setting it here is what pins the origin.
#
# Production: https://tapvyo.in
# Local dev:  leave empty (NEXT_PUBLIC_APP_URL below supplies localhost)
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_APP_URL=

# GA4 measurement ID. OPTIONAL - src/components/GoogleAnalytics.tsx already
# defaults to the live property (G-PMLBD2Q7ZQ), so leaving this empty is fine.
# Set it only to point a deployment at a DIFFERENT property, e.g. a staging one.
# Not a secret: the ID is visible in the page source of every GA4 site.
# Analytics never loads outside a production build regardless of this value.
NEXT_PUBLIC_GA_ID=

# SECRET. Server-only. Signs the httpOnly `auth-token` session cookie, and is
# also used as the pepper when hashing password-reset tokens and blog view
# IP/session digests. REQUIRED in production - the app throws on boot without
# it there, and falls back to an insecure development value locally.
#
# Rotating it logs every user out AND invalidates every outstanding password
# reset link, because both are derived from it. That is intended.
JWT_SECRET=

# Optional. Session lifetime for the auth cookie, as an ms/jsonwebtoken
# duration string. Defaults to "7d" when unset.
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Google sign-in (next-auth)
# ---------------------------------------------------------------------------
# ALL THREE OF THE FIRST THREE ARE REQUIRED TOGETHER. With any one of them
# missing, app/api/auth/[...nextauth]/route.ts registers no providers and every
# next-auth endpoint answers 501 - which is exactly why "Login with Google"
# silently did nothing: next-auth's signIn() swallows that 501 and gives up.
# The button now checks /api/auth/providers first and says so instead.
#
# Create the credentials at Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application, and register BOTH
# of these as Authorized redirect URIs (the path is fixed by next-auth):
#   http://localhost:3000/api/auth/callback/google
#   https://card.tricomakes.in/api/auth/callback/google
# No extra scopes are needed; next-auth requests openid/email/profile.
GOOGLE_CLIENT_ID=

# SECRET. Server-only. Never give this a NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_SECRET=

# SECRET. Signs the next-auth JWT. Generate with: openssl rand -base64 32
# /api/auth/google-complete verifies the next-auth token with this before it
# will issue an app session, so it must be set wherever Google login is used.
NEXTAUTH_SECRET=

# Canonical origin next-auth builds its callback URL from. REQUIRED in
# production: behind a proxy, next-auth cannot reliably infer the external
# origin, and getting it wrong sends users to a callback URL Google will
# reject. Leave unset locally (defaults to http://localhost:3000).
# The card app origin. tricomakes.in itself serves the Trico Makes agency
# site, so the app gets its own subdomain. tapvyo.com is NOT registered.
# e.g. https://card.tricomakes.in
NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
# Public key id (rzp_test_... / rzp_live_...). Safe to expose to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Same key id, read server-side. Keep both set to the same value.
RAZORPAY_KEY_ID=


# SECRET. Server-only. Must never appear in client code or a NEXT_PUBLIC_ var.
RAZORPAY_KEY_SECRET=

# Webhook signing secret from Razorpay Dashboard -> Settings -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# "test" or "live"
RAZORPAY_MODE=test

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
# Backs every admin image upload, including blog cover and inline images
# (folder: admin/blog). SERVER-ONLY - none of these may become a NEXT_PUBLIC_
# variable. Set either CLOUDINARY_URL on its own, or all three below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternative single-value form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------
# SECRET. Server-only - read in src/lib/emails/resend.ts and nowhere else.
# Must never become a NEXT_PUBLIC_ variable.
RESEND_API_KEY=

# From address for every Resend email. The DOMAIN must be verified in Resend.
# Only tricomakes.in is verified on this account; tapvyo.com is not registered
# at all, so sending as @tapvyo.com fails with "The tapvyo.com domain is not
# verified". Keep the brand as the display name - only the domain changes.
# A bare address ("orders@tricomakes.in") gets a display name added for you.
RESEND_FROM_EMAIL="Tapvyo <noreply@tricomakes.in>"

# Legacy name for RESEND_FROM_EMAIL, still read as a fallback so an existing
# environment keeps working. RESEND_FROM_EMAIL wins when both are set. Delete
# this once every environment has the new variable.
# EMAIL_FROM=orders@tricomakes.in

# Reply-to. A real monitored mailbox: the order confirmation tells customers to
# reply within 24 hours to correct what gets printed, so replies must reach a
# person even though From is a noreply address. Defaults to SUPPORT_EMAIL in
# src/lib/site-config.ts when unset.
EMAIL_REPLY_TO=tapvyo@gmail.com

# Optional. Blind-copies every order email to the business, so you see exactly
# what the customer saw. Leave EMPTY until the sending domain is verified in
# Resend: an unverified domain only delivers to the Resend account owner, and a
# bcc elsewhere fails the whole send - including the customer's copy.
EMAIL_BCC=

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# No new variables. The reset flow reuses:
#   - JWT_SECRET        pepper for the stored token digest (above)
#   - RESEND_API_KEY    sends the reset email (below)
#   - RESEND_FROM_EMAIL sender for that email (below)
#   - NEXT_PUBLIC_SITE_URL  builds the absolute link in the email (above).
#     Get this wrong in production and every reset link points at localhost.
#
# With RESEND_API_KEY unset the endpoint still returns its normal generic
# response - it must never reveal whether an account exists - and in
# development ONLY it logs the reset link to the server console so the flow is
# testable. In production an unconfigured provider logs an error instead: the
# link is never printed where it could be harvested.

# ---------------------------------------------------------------------------
# Rate limiting for the public /track-order lookup
# ---------------------------------------------------------------------------
# No extra service needed: counters live in the "rate_limits" collection of the
# DATABASE_URL cluster, which every serverless instance shares. See
# src/lib/track-order-rate-limit.ts. With DATABASE_URL unset, /track-order
# refuses every lookup rather than running unlimited.

# ---------------------------------------------------------------------------
# Blog
# ---------------------------------------------------------------------------
# Show the view counter on public post pages. Admin always sees view counts in
# /admin/blogs regardless of this. Default (unset or anything but "true"): off.
NEXT_PUBLIC_BLOG_SHOW_VIEWS=
